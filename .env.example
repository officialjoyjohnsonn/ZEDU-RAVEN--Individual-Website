# Copy to .env.local and fill in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pick ONE primary DB - app supports both. If both set, Supabase is used for auth/products, Neon for orders fallback.
DATABASE_URL=
# Neon pooled connection string: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require

# NextAuth (Google OAuth via Google Cloud Console)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun for order confirmation emails
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=Shop <noreply@yourdomain.com>

# App
NEXT_PUBLIC_APP_NAME=VOLT District
NEXT_PUBLIC_APP_URL=http://localhost:3000
